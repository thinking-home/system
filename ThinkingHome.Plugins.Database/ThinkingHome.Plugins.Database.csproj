<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Package.xml" />
  <PropertyGroup>
    <Description>ThinkingHome plugin which provide database API (PostgreSQL) for other plugins.</Description>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ThinkingHome.Core.Plugins/ThinkingHome.Core.Plugins.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="ThinkingHome.Migrator" Version="3.10.0" />
    <PackageReference Include="ThinkingHome.Migrator.Providers.PostgreSQL" Version="3.10.0" />
  </ItemGroup>
  <ItemGroup>
    <ThinkingHomeDependency Include="Microsoft.EntityFrameworkCore" Kind="shared" />
    <ThinkingHomeDependency Include="Npgsql.EntityFrameworkCore.PostgreSQL" Kind="private" />
    <ThinkingHomeDependency Include="ThinkingHome.Migrator" Kind="private" />
    <ThinkingHomeDependency Include="ThinkingHome.Migrator.Providers.PostgreSQL" Kind="private" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.11" />
    <ThinkingHomeDependency Include="Microsoft.EntityFrameworkCore.Abstractions" Kind="shared" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <ThinkingHomeDependency Include="Microsoft.EntityFrameworkCore.Relational" Kind="shared" />
    <PackageReference Include="ThinkingHome.Migrator.Framework" Version="3.10.0" />
    <ThinkingHomeDependency Include="ThinkingHome.Migrator.Framework" Kind="shared" />
  </ItemGroup>
  <Import Project="../ThinkingHome.Packaging/build/ThinkingHome.Plugin.targets" />
</Project>
