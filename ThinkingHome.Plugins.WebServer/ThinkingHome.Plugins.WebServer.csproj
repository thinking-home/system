<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../Package.xml" />
    <PropertyGroup>
        <Description>Hosts HTTP resources and a SignalR message bus for ThinkingHome plugins.</Description>
        <PackageTags>$(PackageTags);plugin;http;signalr</PackageTags>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../ThinkingHome.Core.Plugins/ThinkingHome.Core.Plugins.csproj" />
    </ItemGroup>
    <Import Project="../ThinkingHome.Packaging/build/ThinkingHome.Plugin.targets" />
</Project>
