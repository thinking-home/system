<Project>
  <PropertyGroup>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <!-- Импортируется в конце проекта, после описания зависимостей и файлов. -->
  <ItemGroup>
    <Reference Include="@(ThinkingHomeEmbedded)">
      <HintPath>%(ThinkingHomeEmbedded.FullPath)</HintPath>
    </Reference>
    <None Include="@(ThinkingHomeEmbedded)" Pack="true" PackagePath="lib/$(TargetFramework)/" />
  </ItemGroup>
  <Target Name="ThinkingHomeGenerateMetadata" BeforeTargets="GetAssemblyAttributes">
    <Error Condition="'$(TargetFramework)' != 'net10.0'" Text="Plugin packaging v1 requires net10.0." />
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ThinkingHome.Plugin.ManifestVersion</_Parameter1><_Parameter2>1</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ThinkingHome.Plugin.PackageId</_Parameter1><_Parameter2>$(PackageId)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ThinkingHome.Plugin.PackageVersion</_Parameter1><_Parameter2>$(PackageVersion)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'@(ThinkingHomeDependency)' != ''">
        <_Parameter1>ThinkingHome.Plugin.Dependency.%(ThinkingHomeDependency.Identity)</_Parameter1><_Parameter2>%(ThinkingHomeDependency.Kind)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'@(ThinkingHomeEmbedded)' != ''">
        <_Parameter1>ThinkingHome.Plugin.Embedded.%(ThinkingHomeEmbedded.Filename)</_Parameter1><_Parameter2>%(ThinkingHomeEmbedded.Kind)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
  <Target Name="ThinkingHomeGuardPack" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(ThinkingHomePackaging)' != 'true'" Text="Use ThinkingHome.Packaging pack to validate before publishing the package." />
  </Target>
  <Target Name="ThinkingHomeWriteValidationInputs" AfterTargets="Build" Condition="'$(ThinkingHomeValidationDirectory)' != ''">
    <MakeDir Directories="$(ThinkingHomeValidationDirectory)" />
    <WriteLinesToFile File="$(ThinkingHomeValidationDirectory)/references.txt" Lines="@(ReferencePath->'%(FullPath)')" Overwrite="true" />
    <WriteLinesToFile File="$(ThinkingHomeValidationDirectory)/ownership.txt" Lines="@(ReferencePath->'%(FullPath)|%(NuGetPackageId)|%(MSBuildSourceProjectFile)|%(FrameworkReferenceName)')" Overwrite="true" />
    <WriteLinesToFile File="$(ThinkingHomeValidationDirectory)/framework.txt" Lines="$(TargetFramework)" Overwrite="true" />
    <WriteLinesToFile File="$(ThinkingHomeValidationDirectory)/assets.txt" Lines="$(ProjectAssetsFile)" Overwrite="true" />
  </Target>
</Project>
