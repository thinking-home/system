<Project>
  <PropertyGroup>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <_ThinkingHomeReferenceTargets>$(MSBuildThisFileDirectory)ThinkingHome.Reference.targets</_ThinkingHomeReferenceTargets>
  </PropertyGroup>
  <!-- Импортируется в конце проекта, после описания зависимостей и файлов. -->
  <ItemGroup>
    <Reference Include="@(ThinkingHomeEmbedded)">
      <HintPath>%(ThinkingHomeEmbedded.FullPath)</HintPath>
    </Reference>
    <None Include="@(ThinkingHomeEmbedded)" Pack="true" PackagePath="lib/$(TargetFramework)/" />
  </ItemGroup>
  <Target Name="ThinkingHomeGenerateMetadata" BeforeTargets="GetAssemblyAttributes">
    <Error Condition="'$(TargetFramework)' != 'net10.0'" Text="Plugin packaging v1 requires net10.0." />
    <Error Condition="'%(PackageReference.ThinkingHomeShared)' != '' and '%(PackageReference.ThinkingHomeShared)' != 'true' and '%(PackageReference.ThinkingHomeShared)' != 'false'"
           Text="ThinkingHomeShared must be true or false: %(PackageReference.Identity)" />
    <Error Condition="'%(ProjectReference.ThinkingHomeShared)' != '' and '%(ProjectReference.ThinkingHomeShared)' != 'true' and '%(ProjectReference.ThinkingHomeShared)' != 'false'"
           Text="ThinkingHomeShared must be true or false: %(ProjectReference.Identity)" />
    <ItemGroup>
      <_ThinkingHomeSharedProject Include="@(ProjectReference)" Condition="'%(ProjectReference.ThinkingHomeShared)' == 'true'" />
      <_ThinkingHomeShared Include="@(PackageReference)" Condition="'%(PackageReference.ThinkingHomeShared)' == 'true'" />
    </ItemGroup>
    <!-- PackageId проекта может отличаться от имени проекта и DLL. Читаем его после оценки SDK. -->
    <MSBuild Projects="@(_ThinkingHomeSharedProject)" Targets="ThinkingHomeGetReferenceIdentity"
             Properties="CustomAfterMicrosoftCommonTargets=$(_ThinkingHomeReferenceTargets);ThinkingHomeOriginalAfterCommonTargets=$(CustomAfterMicrosoftCommonTargets)"
             Condition="'@(_ThinkingHomeSharedProject)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_ThinkingHomeShared" />
    </MSBuild>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ThinkingHome.Plugin.ManifestVersion</_Parameter1><_Parameter2>1</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ThinkingHome.Plugin.PackageId</_Parameter1><_Parameter2>$(PackageId)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ThinkingHome.Plugin.PackageVersion</_Parameter1><_Parameter2>$(PackageVersion)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'@(_ThinkingHomeShared)' != ''">
        <_Parameter1>ThinkingHome.Plugin.Dependency.%(_ThinkingHomeShared.Identity)</_Parameter1><_Parameter2>shared</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'@(ThinkingHomeEmbedded)' != ''">
        <_Parameter1>ThinkingHome.Plugin.Embedded.%(ThinkingHomeEmbedded.Filename)</_Parameter1><_Parameter2>%(ThinkingHomeEmbedded.Kind)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
  <Target Name="ThinkingHomeGuardPack" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(ThinkingHomePackaging)' != 'true'" Text="Use ThinkingHome.Packaging pack to validate before publishing the package." />
  </Target>
  <Target Name="ThinkingHomeWriteValidationInputs" AfterTargets="Build" Condition="'$(ThinkingHomeValidationDirectory)' != ''">
    <MakeDir Directories="$(ThinkingHomeValidationDirectory)" />
    <WriteLinesToFile File="$(ThinkingHomeValidationDirectory)/references.txt" Lines="@(ReferencePath->'%(FullPath)')" Overwrite="true" />
    <WriteLinesToFile File="$(ThinkingHomeValidationDirectory)/ownership.txt" Lines="@(ReferencePath->'%(FullPath)|%(NuGetPackageId)|%(MSBuildSourceProjectFile)|%(FrameworkReferenceName)')" Overwrite="true" />
    <WriteLinesToFile File="$(ThinkingHomeValidationDirectory)/framework.txt" Lines="$(TargetFramework)" Overwrite="true" />
    <WriteLinesToFile File="$(ThinkingHomeValidationDirectory)/assets.txt" Lines="$(ProjectAssetsFile)" Overwrite="true" />
  </Target>
</Project>
