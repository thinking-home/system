<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Package.xml" />
  <PropertyGroup>
    <Description>Runs the ThinkingHome host and manages installed plugins with the th command.</Description>
    <PackageTags>$(PackageTags);dotnet-tool</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>th</ToolCommandName>
    <PackageReadmeFile>TOOL.md</PackageReadmeFile>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="logs\**\*" />
    <None Update="TOOL.md" Pack="true" PackagePath="/" />
    <None Update="README.md" Pack="false" />
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ThinkingHome.Core.Infrastructure\ThinkingHome.Core.Infrastructure.csproj" />
    <ProjectReference Include="../ThinkingHome.PackageManagement/ThinkingHome.PackageManagement.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>
  <Target Name="SelectToolRuntimeFiles" AfterTargets="ComputeFilesToPublish" Condition="'$(_IsPacking)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' != '.dll' And '%(ResolvedFileToPublish.RelativePath)' != '$(AssemblyName).deps.json' And '%(ResolvedFileToPublish.RelativePath)' != '$(AssemblyName).runtimeconfig.json'" />
    </ItemGroup>
  </Target>
</Project>
