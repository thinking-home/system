<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Package.xml" />
  <PropertyGroup>
    <Description>ThinkingHome plugin which provide the web API for cron task management.</Description>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ThinkingHome.Core.Plugins/ThinkingHome.Core.Plugins.csproj" />
    <ProjectReference Include="../ThinkingHome.Plugins.Database/ThinkingHome.Plugins.Database.csproj" />
    <ProjectReference Include="../ThinkingHome.Plugins.Cron/ThinkingHome.Plugins.Cron.csproj" />
    <ProjectReference Include="../ThinkingHome.Plugins.WebServer/ThinkingHome.Plugins.WebServer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CronExpressionDescriptor" Version="2.51.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ThinkingHomeDependency Include="ThinkingHome.Plugins.Database" Kind="plugin" />
    <ThinkingHomeDependency Include="ThinkingHome.Plugins.Cron" Kind="plugin" />
    <ThinkingHomeDependency Include="ThinkingHome.Plugins.WebServer" Kind="plugin" />
    <ThinkingHomeDependency Include="CronExpressionDescriptor" Kind="private" />
  </ItemGroup>
  <Import Project="../ThinkingHome.Packaging/build/ThinkingHome.Plugin.targets" />
</Project>
