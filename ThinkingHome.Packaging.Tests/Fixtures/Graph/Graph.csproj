<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Fixture.Graph</PackageId>
    <Version>1.0.0</Version>
    <Description>Dependency graph fixture</Description>
    <DependencyKind Condition="'$(DependencyKind)' == ''">private</DependencyKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../ThinkingHome.Core.Plugins/ThinkingHome.Core.Plugins.csproj" />
    <ProjectReference Include="../Dependency/Dependency.csproj" />
    <ThinkingHomeDependency Include="Fixture.Dependency" Kind="$(DependencyKind)" />
    <ThinkingHomeDependency Include="$(PeerId)" Kind="plugin" Condition="'$(PeerId)' != ''" />
  </ItemGroup>
  <Import Project="../../../ThinkingHome.Packaging/build/ThinkingHome.Plugin.targets" />
</Project>
